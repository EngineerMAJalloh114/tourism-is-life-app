# Every variable below is one the code actually reads. All are optional locally:
# with none set the app runs in demo mode (embedded PGLite, demo payments).

# --- Database ---------------------------------------------------------------
# Real Postgres / Neon. REQUIRED in production (PGLite is refused when deployed).
# DATABASE_URL=postgresql://user:password@localhost:5432/tourismislife

# --- Auth (Better Auth, email/password sign-in) -------------------------------
# Social login is switched off in the UI (SOCIAL_LOGIN_ENABLED = false) and there
# is no standalone Google/X OAuth wiring in the code.
# BETTER_AUTH_URL=https://your-domain
# BETTER_AUTH_SECRET=
# The code still carries an optional Grok auth-broker path; it is not exposed in the UI.
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# Only this address may claim the one-time SUPER_ADMIN bootstrap when deployed.
# BOOTSTRAP_ADMIN_EMAIL=

# --- Local test SUPER_ADMIN (npm run dev:local only, never in Vercel) -----------
# Seeds one SUPER_ADMIN into the in-memory PGLite database on start. Refused
# whenever DATABASE_URL or DATABASE_URL_UNPOOLED is set. Use test values only;
# the account still sets up two-factor on its first sign-in.
# LOCAL_SUPER_ADMIN_EMAIL=
# LOCAL_SUPER_ADMIN_PASSWORD=

# --- Payments (demo mode works without these) --------------------------------
# APP_ORIGIN=https://tourismislife.com
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MONEROO_SECRET_KEY=
# MONEROO_WEBHOOK_SECRET=

# --- Notifications -------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM=Tourism Is Life <info@tourismislife.com>
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# --- Scheduled jobs --------------------------------------------------------------
# Bearer secret for /api/cron/expire-holds (a scheduler sends `Authorization: Bearer <value>`).
# CRON_SECRET=

# --- Optional Redis (distributed hold lock + rate limiting) -----------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Media library uploads: Supabase Storage (admin, task A6) --------------------
# All four together switch uploads on; with none set, uploads are off on a
# deployment (npm run dev:local uses files in .local-media/ instead).
# SUPABASE_SERVICE_KEY is the project's secret key: server only. Never prefix
# any of these with VITE_, which would put them in the browser bundle.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_PUBLIC_BUCKET=
# SUPABASE_INCOMING_BUCKET=

# --- Optional object storage (public URL helper only; no upload client yet) -------
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_ENDPOINT=
# R2_PUBLIC_BASE=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_ENDPOINT=
# S3_PUBLIC_BASE=
